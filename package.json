{
    "name": "stderr-lib",
    "version": "2.3.0",
    "description": "Normalize unknown error values to a standard format with cause chain support.",
    "author": "Michael L. Hobbs",
    "homepage": "https://github.com/MichaelLeeHobbs/stderr#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MichaelLeeHobbs/stderr.git"
    },
    "bugs": {
        "url": "https://github.com/MichaelLeeHobbs/stderr/issues"
    },
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "sideEffects": false,
    "publishConfig": {
        "access": "public",
        "audit-level": "high"
    },
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.mts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsup",
        "build:watch": "tsup --watch",
        "test": "vitest run --coverage.enabled=false",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "verify:dist": "node scripts/verify-dist.mjs",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json --noEmit",
        "typecheck:test-types": "tsc --project test-types/tsconfig.json --noEmit",
        "clean": "rimraf dist coverage",
        "prepare": "husky",
        "prepublishOnly": "pnpm run clean && pnpm run build && pnpm run lint:fix && pnpm run test:coverage && pnpm run verify:dist",
        "version:major": "npm version major",
        "version:minor": "npm version minor",
        "version:patch": "npm version patch",
        "preversion": "pnpm run lint && pnpm run test:coverage",
        "postversion": "git push && git push --tags",
        "dry-run": "npm pack --dry-run"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/benchmark": "^2.1.5",
        "@types/node": "^22.20.5",
        "@vitest/coverage-istanbul": "^5.0.5",
        "benchmark": "^2.1.4",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "fast-check": "^4.10.2",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "rimraf": "^6.1.3",
        "tsup": "^9.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.0.5"
    },
    "keywords": [
        "error",
        "errors",
        "normalize",
        "stderr",
        "exception",
        "cause",
        "aggregate-error",
        "error-handling",
        "typescript",
        "javascript"
    ],
    "license": "MIT",
    "packageManager": "pnpm@10.33.4",
    "engines": {
        "node": ">=22"
    }
}
